# Copy to .env.local and fill in from the Supabase project dashboard
# (Settings > API Keys > "Publishable and secret API keys" tab).
#
# These are Supabase's new key format (sb_publishable_..., sb_secret_...),
# not the legacy anon/service_role JWTs — Supabase is deprecating those by
# end of 2026. Same privilege levels: publishable = old anon, secret = old
# service_role. If your project only shows legacy keys, click
# "Create new API keys" in that dashboard section first.
NEXT_PUBLIC_SUPABASE_URL=https://fjdflxsckmyjcifctbob.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qFPgegwX47vMSzpWC6tsDg_IOkBWuxX
SUPABASE_SECRET_KEY=sb_secret_6mXpvD8SAv8xCmWLk34K0A_lC1iaeHH

# Used starting Phase 3 (Spotify integration) — not needed yet.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
